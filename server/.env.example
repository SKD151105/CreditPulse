# Server
PORT=5000
NODE_ENV=development

# Database — local default
MONGO_URI=mongodb://localhost:27017/creditpulse

# Redis — local default
REDIS_URI=redis://localhost:6379

# JWT — local default secrets (change in production)
JWT_ACCESS_SECRET=local_access_secret_change_in_production
JWT_REFRESH_SECRET=local_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 — Fill these when implementing document uploads
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# Google OAuth — Fill these when implementing Google login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL
CLIENT_URL=http://localhost:5173

# Admin Setup
SUPER_ADMIN_SECRET=dummy

# SMTP (for emails) — Fill these to test emails locally
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="CreditPulse <your_smtp_user@example.com>"
